@model List<EntityManagementAspNet.Business.Dtos.PersonResponse>

@{ 
    ViewData["Title"] = "Kişi Listesi";
    Layout = null;
}

<h1>Kişi Listesi</h1>

<p>
    <a asp-action="Create" asp-protocol="@Context.Request.Scheme" asp-host="@Context.Request.Host" class="btn btn-primary">Yeni Kişi Ekle</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Ad</th>
            <th>Soyad</th>
            <th>E-posta</th>
            <th>Telefon</th>
            <th>Yaş</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Surname</td>
                <td>@item.Email</td>
                <td>@item.PhoneNumber</td>
                <td>@item.Age</td>
                <td>
                    <form asp-action="Delete" asp-protocol="@Context.Request.Scheme" asp-host="@Context.Request.Host" asp-route-name="@item.Name" method="post" onsubmit="return confirm('Bu kaydı silmek istediğinizden emin misiniz?')">
                        <button type="submit" class="btn btn-danger btn-sm">Sil</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
